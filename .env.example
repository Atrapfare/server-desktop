# Kopie als .env anlegen und ausfuellen. .env ist per .gitignore ausgeschlossen.

# Geheime iCal-URL des Kalenders (Google Kalender: Einstellungen ->
# "Geheime Adresse im iCal-Format"). Pflichtangabe, sonst startet der
# CalendarCollector nicht.
CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/BEISPIEL/basic.ics

# Endpunkt des VPS-Agents - das lokale Ende des SSH-Tunnels, nicht der VPS
# selbst; der Agent lauscht dort nur auf localhost.
#
# Im Container:            http://host.docker.internal:9100/stats
# Jar direkt auf dem Host: http://localhost:9100/stats
VPS_STATS_URL=http://host.docker.internal:9100/stats

# Anzeigename des Rechners, auf dem das Dashboard laeuft. Ohne Angabe steht
# im Container die Container-ID in der Kachel. In der compose.yml ist der
# Name bereits gesetzt; diese Variable ist fuer den Betrieb ohne Compose.
HOST_NAME=heimserver

# Dateisystem, dessen Belegung die Heimserver-Kachel meldet.
#
# Im Container:            /hostfs   (setzt den Bind-Mount aus compose.yml voraus)
# Jar direkt auf dem Host: /
HOST_DISK_PATH=/hostfs

# Haltestellen-IDs des VVS fuer die Fahrplan-Kachel. Voreingestellt ist
# Stuttgart, Laihle -> Stuttgart, Universitaet. Eigene IDs findet man ueber
# https://www3.vvs.de/vvs/XML_STOPFINDER_REQUEST?outputFormat=rapidJSON&type_sf=any&name_sf=<Haltestelle>
TRANSIT_ORIGIN=de:08111:2420
TRANSIT_DESTINATION=de:08111:6008
